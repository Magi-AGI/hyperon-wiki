# atomspace-mirror OPS TUNABLES (Phase 5). Copy to /home/ubuntu/atomspace-mirror.env, chmod 0600,
# chown ubuntu:ubuntu. Sourced (optionally) by the sidecar/drain/drift units for the sidecar + drift
# tunables below. It holds NO DB credentials and NO app secrets.
#
# THE MASTER ACTIVATION GATE DOES NOT LIVE HERE. `ATOMSPACE_MIRRORING_ENABLED` must reach the Rails
# WEB process (the save hook + read-consistency binding + readiness) AND every write-capable worker,
# and those processes source the APP env file (/home/ubuntu/hyperon-wiki/.env.production), NOT this
# file. So set the gate in .env.production at activation time (see the runbook), where web, jobs,
# drain, and drift all pick it up:
#     ATOMSPACE_MIRRORING_ENABLED=true
# Setting it here would NOT activate the web hook and is intentionally omitted.

# Drift Mechanism-3 (full-projection) sidecar read timeout. 60s covers the O(n) /projection_index
# cost at the production corpus (~9.6K cards / ~17K atoms; measured ~7.4s > the 5s client default).
ATOMSPACE_DRIFT_READ_TIMEOUT=60

# Read-your-writes poll bounds (controller-side; keep the Puma worker occupancy short). These matter
# to the WEB process, so also set them in .env.production if the web unit does not source this file.
READ_YOUR_WRITES_MAX_WAIT_SECONDS=2
READ_YOUR_WRITES_POLL_INTERVAL_MS=50

# Sidecar IPC. SIDECAR_RUN_DIR MUST match the Ruby SidecarClient/SidecarReadClient default
# (/home/ubuntu/atomspace-run) OR be exported to the web+drain processes too. Same-user (ubuntu)
# deployment: the sidecar creates it 0700 and the socket 0600 -- no shared group needed.
SIDECAR_RUN_DIR=/home/ubuntu/atomspace-run
SIDECAR_PORT=9407
# SIDECAR_ALLOW_NONLOOPBACK must NEVER be set in production (it would expose unauthenticated
# /apply + /bulk_load to the network).
