# Level 5 drift stream monitors: `rake atomspace_mirror:drift_schedule` (report-only, Section 2
# cadences: hook-tail-lag 30s / coverage-gap 300s / drain-lag 60s + missed-run watchdog).
# Install: copy to /etc/systemd/system/atomspace-mirror-drift.service (drop .example), daemon-reload.
# Report-only + pure Postgres (no sidecar), so Restart=on-failure is safe and it does NOT BindsTo the
# sidecar -- it keeps reporting even during a sidecar incident. Boot auto-start is harmless (before
# activation it simply reports a not-bootstrapped baseline), so [Install] is retained; enable it only
# once you want continuous drift reporting.
#
# The Mechanism-3 full-projection sweep (`rake atomspace_mirror:drift_sweep`, the O(n) PG-vs-Space
# hash reconciliation) is a SEPARATE off-hours job -- run it from a systemd .timer or cron, not here.
[Unit]
Description=AtomSpace Mirror drift stream monitors (Level 5, report-only)
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hyperon-wiki
# App env FIRST (DB + RAILS_ENV; the monitors are pure Postgres queries and need the DB credentials),
# then the atomspace ops tunables (optional).
EnvironmentFile=/home/ubuntu/hyperon-wiki/.env.production
EnvironmentFile=-/home/ubuntu/atomspace-mirror.env
Environment=RAILS_ENV=production
Environment=PATH=/home/ubuntu/.rbenv/shims:/home/ubuntu/.rbenv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.rbenv/shims/bundle exec rake atomspace_mirror:drift_schedule
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
# SIGTERM calls scheduler.shutdown; in-flight monitor queries finish first. TimeoutStopSec bounds it.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
